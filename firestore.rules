rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validChatParticipants(data) {
      return data.keys().hasAll(["participants"])
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string
        && data.participants[1] is string
        && data.participants[0] != data.participants[1]
        && request.auth.uid in data.participants;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    match /users/{userId} {
      // The current app has a signed-in user directory; profile fields,
      // including email, are readable by all authenticated users.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "uid", "name", "username", "email", "photoURL",
          "createdAt", "lastSeen"
        ])
        && request.resource.data.keys().hasAll([
          "uid", "name", "username", "email", "photoURL",
          "createdAt", "lastSeen"
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.photoURL is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time;

      // Existing profiles are only changed to refresh lastSeen.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastSeen"])
        && request.resource.data.lastSeen == request.time;

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && validChatParticipants(request.resource.data)
        && request.resource.data.keys().hasOnly([
          "participants", "participantNames", "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && (
          !("participantNames" in request.resource.data)
          || request.resource.data.participantNames is map
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "lastMessage", "lastMessageSenderId", "updatedAt"
          ])
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["lastMessage"])
          || (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 5000
            && request.resource.data.lastMessageSenderId == request.auth.uid
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            "text", "senderId", "receiverId", "createdAt"
          ])
          && request.resource.data.keys().hasAll([
            "text", "senderId", "receiverId", "createdAt"
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
